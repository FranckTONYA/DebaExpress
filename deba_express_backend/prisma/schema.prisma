// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
  previewFeatures = ["driverAdapters"]
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum TypeMesure {
  POIDS  // Calcul : poids * prixUnitaire
  PIECE  // Calcul : nombrePiece * prixUnitaire
}

enum StatutEnvoi {
  ENREGISTRE
  EN_ENTREPOT
  EN_VOL
  DOUANE
  ARRIVE_DESTINATION
  LIVRE
}

enum Role {
  ADMINISTRATEUR
  GESTIONNAIRE
  CLIENT
}

model CategorieColis {
  id             String               @id @default(uuid())
  nom            String               @unique // Ex: "Électronique", "Vêtements"
  description    String?
  
  // Valeurs génériques obligatoires au niveau de la catégorie
  prixUnitaire   Float
  mesure         TypeMesure 
  
  sousCategories SousCategorieColis[]
  createdAt      DateTime             @default(now())
}

model SousCategorieColis {
  id           String         @id @default(uuid())
  nom          String         // Ex: "Téléphone", "Ordinateur", "Robe"
  
  // OPTIONNELS (?) : Si présents, ils écrasent les valeurs de la catégorie.
  prixUnitaire Float?         
  mesure       TypeMesure?    
  
  categorieId  String
  categorie    CategorieColis @relation(fields: [categorieId], references: [id], onDelete: Cascade)
  
  colis        Colis[]        
  createdAt    DateTime       @default(now())

  @@unique([nom, categorieId]) 
}

model Client {
  id              String   @id @default(uuid())
  numeroClient    String   @unique
  nom             String
  prenom          String
  email           String   @unique
  telephone       String
  adresse         String?
  dateNaissance   DateTime?
  
  colis           Colis[]  @relation("ClientExpediteur")
  utilisateur     Utilisateur?
  createdAt       DateTime @default(now())
}

model Colis {
  id              String             @id @default(uuid())
  codeSuivi       String?            @unique
  description     String?
  
  // Historisation des valeurs appliquées au moment du dépôt
  prixUnitaireApp Float              
  mesureApp       TypeMesure         
  
  quantite        Float              
  prixTotal       Float
  destination     String
  dateDepot       DateTime
  dateEnvoi       DateTime
  dateReception   DateTime             
  etatSortie      String?
  statut          StatutEnvoi        @default(ENREGISTRE)
  
  sousCategorieId String
  sousCategorie   SousCategorieColis @relation(fields: [sousCategorieId], references: [id])
  
  expediteurId    String
  expediteur      Client             @relation("ClientExpediteur", fields: [expediteurId], references: [id], onDelete: Cascade)
  
  facture         Facture?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Facture {
  id          String   @id @default(uuid())
  numeroFact  String   @unique
  montant     Float
  avance      Float
  estPaye     Boolean  @default(false)
  
  colisId     String   @unique
  colis       Colis    @relation(fields: [colisId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

model Utilisateur {
  id         String   @id @default(uuid())
  email      String   @unique
  motDePasse String   // Hash bcrypt
  role       Role     @default(CLIENT)
  
  nom        String
  prenom     String
  telephone  String
  adresse    String?  // Optionnel (non obligatoire)
  
  createdAt  DateTime @default(now())

  clientId   String?  @unique
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

